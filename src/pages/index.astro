---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.jsx";
import Section from "../components/Section.jsx";
import skillsBg from "../assets/skills-bg.png";
import contactBg from "../assets/contact-bg.png";
---

<Layout title="Jordan Friesen | Front End Developer">
	<main>
		<Hero client:load />

		<div class="relative z-20 bg-slate-950 pb-20">
			<Section
				client:visible
				title="Technical Arsenal"
				description="A comprehensive array of battle-tested frontend technologies and frameworks. Deployed for high-performance, scalable web solutions."
				color="cyan"
				image={skillsBg}
				href="/skills"
				buttonText="Inspect Capabilities"
			/>

			<Section
				client:visible
				title="Establish Comms"
				description="Ready to mobilize? Initiate a secure connection to discuss potential deployments, collaborations, or technical directives."
				reverse={true}
				color="purple"
				image={contactBg}
				href="/contact"
				buttonText="Open Channel"
			/>

			{
				/* <Section
				client:visible
				title="TailwindCSS v4 Power"
				description="Style your application with the utility-first power of TailwindCSS. Now even faster and simpler with the latest v4 engine and Vite integration."
				color="blue"
			/> */
			}
		</div>

		<footer
			class="py-12 border-t border-slate-800 text-center text-slate-500"
		>
			<p>Built with Astro, React, and Lenis.</p>
		</footer>
	</main>
</Layout>
